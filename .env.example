# Shared defaults for `docker compose` and the helper scripts. Copy to .env (Compose reads it
# automatically). Each app has its own template for variables only that app reads:
#   apps/api-py/.env.example   FastAPI backend (checked against src/core/config.py in CI)
#   apps/web/.env.example      Next.js app
#   apps/mobile/.env.example   Expo app
#   apps/api/.env.example      legacy NestJS API, until it is decommissioned
#
# Ports: API 8000, web 3000, Postgres 5432, Vault (dev profile) 8200.

# ── Postgres (docker-compose.yml) ────────────────────────────────────────────
POSTGRES_USER=mixmatch
POSTGRES_PASSWORD=mixmatch_password
POSTGRES_DB=mixmatch_dev
POSTGRES_PORT=5432

# ── Published ports (docker-compose.yml) ─────────────────────────────────────
API_PORT=8000
WEB_PORT=3000

# ── Values passed through to the containers (leave unset for development defaults) ──
# JWT_SECRET=
# WALLET_ENCRYPTION_KEY=
# STELLAR_NETWORK=testnet
# HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Vault dev profile: docker compose --profile vault up ─────────────────────
# VAULT_DEV_ROOT_TOKEN=root

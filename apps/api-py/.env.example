# FastAPI backend settings (apps/api-py/src/core/config.py). Copy to apps/api-py/.env.
# `tests/test_env_templates.py` fails when this file and the Settings fields drift apart:
# every setting must appear here, either set or as a commented `# KEY=value` line.

# "development" or "production". In production the app refuses to start with default or
# placeholder secrets (see config.py).
NODE_ENV=development
PORT=8000
API_PREFIX=/api

# SQLAlchemy async URL. SQLite is for tests and quick local runs; use Postgres otherwise:
# DATABASE_URL=postgresql+asyncpg://mixmatch:mixmatch_password@localhost:5432/mixmatch_dev
DATABASE_URL=sqlite+aiosqlite:///./test.db

# Secret used to sign JWTs: at least 32 characters, not a placeholder in production.
# Generate one with: openssl rand -base64 48
JWT_SECRET=<generate with: openssl rand -base64 48>
JWT_EXPIRATION_DELTA_SECONDS=86400

# AES-256-GCM key for custodial wallet secrets: exactly 64 hex characters.
# Generate one with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=<generate with: openssl rand -hex 32>

# "testnet" or "public". ANCHOR_HOME_DOMAIN is required when the network is "public".
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
# ANCHOR_HOME_DOMAIN=testanchor.stellar.org
# Asset offered by the anchor and shown in the in-app asset picker (#1386).
ANCHOR_ASSET_CODE=SRT
# ANCHOR_ASSET_ISSUER=G...

# Audio uploads: signed object-storage URLs, virus scan hook and async transcode (#1380).
UPLOAD_MAX_BYTES=52428800
UPLOAD_SIGNED_URL_TTL_SECONDS=900
UPLOAD_STORAGE_BUCKET=mixmatch-audio
UPLOAD_STORAGE_BASE_URL=https://storage.mixmatch.app
# UPLOAD_VIRUS_SCAN_WEBHOOK=https://scanner.internal/scan
# UPLOAD_TRANSCODE_WEBHOOK=https://transcoder.internal/jobs

# HashiCorp Vault transit KMS. Leave VAULT_ADDR unset to use the WALLET_ENCRYPTION_KEY path.
# VAULT_TOKEN is required whenever VAULT_ADDR is set.
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=root

# Native-XLM amount above which a payment needs admin co-signing.
HIGH_VALUE_THRESHOLD_XLM=1000
# A PENDING transaction is left alone this long before reconciliation touches it.
RECONCILIATION_STALE_MS=300000
RECONCILIATION_CONCURRENCY_LIMIT=10

ENABLE_TASTE_CRON=false

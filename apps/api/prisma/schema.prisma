generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  role           String          @default("USER")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  stellarAccount StellarAccount?

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Property {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   @default("STRING")
  required    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("properties")
}

model StellarAccount {
  id                  String   @id @default(uuid())
  userId              String   @unique
  publicKey           String   @unique
  // AES-256-GCM ciphertext of the account's Stellar secret key, see
  // modules/payments/wallet-encryption.ts. Never stored in plaintext.
  encryptedSecretKey  String
  network             String   @default("testnet")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("stellar_accounts")
}

model Transaction {
  id                   String    @id @default(uuid())
  // Client-supplied (or server-generated, if omitted) key used to dedupe
  // repeated payment requests at the database layer. See
  // modules/payments/transaction.repository.ts.
  idempotencyKey       String    @unique
  stellarAccountId     String
  destinationPublicKey String
  amount               String
  memo                 String?
  status               String    @default("PENDING")
  stellarTxHash        String?
  failureCode          String?
  failureReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  stellarAccount StellarAccount @relation(fields: [stellarAccountId], references: [id], onDelete: Cascade)

  @@index([stellarAccountId])
  @@index([status])
  @@map("transactions")
}

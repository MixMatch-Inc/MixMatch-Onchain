{
  "expo": {
    "name": "MixMatch",
    "slug": "mixmatch",
    "scheme": "mixmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "MixMatch uses your camera to scan a payment QR code."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "MixMatch uses your camera to scan a payment QR code."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "MixMatch uses Face ID to unlock secure wallet actions."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MixMatch uses Face ID to approve payments."
        }
      ]
    ]
  }
}

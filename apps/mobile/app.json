{
  "expo": {
    "name": "MixMatch Onchain",
    "slug": "mixmatch-onchain",
    "scheme": "mixmatch",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "MixMatch Onchain uses your camera to scan payment QR codes."
      }
    },
    "android": {
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "MixMatch Onchain uses your camera to scan payment QR codes."
        }
      ]
    ]
  }
}
